# Copy to .env on the server and fill in. Never commit .env.
# Database and login passwords are NOT here: they go in deploy/secrets/ (see docs/deployment.md).
# Caddy's fixed IP on the edge network (set in server-infra).
CADDY_ADDRESS=172.30.0.2
# Email (optional). Any provider that offers SMTP works. Leave SMTP_HOST empty to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
